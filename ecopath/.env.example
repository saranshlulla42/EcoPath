# ============================================================
# EcoPath — Environment Variables Template
# Copy this file to backend/.env and frontend/.env.local
# NEVER commit actual secrets to git
# ============================================================

# ─── Backend (backend/.env) ──────────────────────────────────────────────────

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI (required)
GEMINI_API_KEY=AIzaSyCEn-zQJYe-KOvrfRB-WSct8YQcwe1h5NY
GEMINI_PRO_MODEL=gemini-2.5-flash
GEMINI_FLASH_MODEL=gemini-2.5-flash

# Groq (required — powers the chat agent)
GROQ_API_KEY=your-groq-api-key-here
AGENT_MODEL=openai/gpt-oss-120b

# Local report model (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REPORT_MODEL=ecopath-extinction-risk
OLLAMA_TIMEOUT_SECONDS=120

# Optional external evidence/search sources
IUCN_API_TOKEN=your_iucn_api_token_here
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
IUCN_BASE_URL=https://apiv3.iucnredlist.org/api/v3

# GBIF (no key required)
GBIF_BASE_URL=https://api.gbif.org/v1
GBIF_AVES_TAXON_KEY=212
GBIF_COUNTRY_CODE=IN

# Open-Meteo (no key required)
OPENMETEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# xeno-canto (no key required)
XENOCANTO_BASE_URL=https://xeno-canto.org/api/2/recordings

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info

# ─── Frontend (frontend/.env.local) ─────────────────────────────────────────

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/dark

# eBird API Key (migration feature)
NEXT_PUBLIC_EBIRD_API_KEY=your_ebird_api_key_here
